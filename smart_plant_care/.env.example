# This project does not load .env automatically. Set these values in the shell
# or configure them in the production hosting platform.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example.com
DEVICE_API_TOKEN=replace-with-a-long-random-token
SENSOR_PROVIDER_CLASS=plant_care.services.database_sensor.DatabaseSensorProvider
